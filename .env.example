# Copy this file to .env and fill in real values.
# .env must stay in .gitignore — never commit real secrets.
# The same variables (minus CRON_SECRET, which is only needed on Vercel)
# are required to run the update:news script locally.

# Fine-grained GitHub PAT, scoped to this repo only.
# Permissions needed: Contents (Read and write), Pull requests (Read and write)
GITHUB_TOKEN=

# Anthropic API key, used by the news/timeline research pipeline
# (scripts/pipeline/) for web search + summarisation.
ANTHROPIC_API_KEY=

# GitHub repo the pipeline reads data/*.json from and opens PRs against.
GITHUB_OWNER=
GITHUB_REPO=

# Only needed on Vercel (Project Settings -> Environment Variables).
# Vercel Cron automatically sends this value as
# `Authorization: Bearer <CRON_SECRET>` on scheduled invocations — set it
# here and in Vercel so /api/cron/update-news rejects any other caller.
# Leave unset locally; the route skips the check when it's not set.
CRON_SECRET=
